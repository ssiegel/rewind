{
  "name": "opencode-rewind",
  "version": "0.1.8",
  "description": "OpenCode session viewer and observability dashboard",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-rewind": "./bin/opencode-rewind.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers/opencode": {
      "import": "./dist/providers/opencode.js",
      "types": "./dist/providers/opencode.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    ".next/BUILD_ID",
    ".next/app-path-routes-manifest.json",
    ".next/build-manifest.json",
    ".next/package.json",
    ".next/prerender-manifest.json",
    ".next/required-server-files.json",
    ".next/routes-manifest.json",
    ".next/server",
    ".next/static"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "dev:lib": "tsc -p tsconfig.lib.json --watch",
    "dev": "pnpm build && next dev --turbopack -p 3838",
    "build:app": "rm -rf .next && next build",
    "serve": "node ./bin/opencode-rewind.js",
    "prepack": "npm run build && npm run build:app",
    "smoke:pack": "node ./scripts/smoke-pack.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf dist .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "agent",
    "opencode",
    "session",
    "conversation",
    "history",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanmessina/rewind.git"
  },
  "homepage": "https://github.com/jordanmessina/rewind#readme",
  "bugs": {
    "url": "https://github.com/jordanmessina/rewind/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@next/swc-darwin-arm64",
      "@tailwindcss/oxide-darwin-arm64",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
